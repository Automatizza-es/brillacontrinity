# Public connection settings only. Copy to .env.local (ignored by git).
# These public values are needed at runtime by the connected public pages and /admin.
# Build the Vercel output with NITRO_PRESET=vercel (local build command only).
# Vercel Preview: configure these names only in the approved Preview environment.
# VERCEL_ENV is set by Vercel; do not hardcode it or change Production variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Never put sb_secret_*, service_role, database passwords or access tokens here.
